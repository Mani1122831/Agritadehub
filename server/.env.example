PORT=5000
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/agritrade_hub?retryWrites=true&w=majority"
JWT_SECRET=your_jwt_secret_key_here
GEMINI_API_KEY=your_gemini_api_key_here
CLIENT_URL=http://localhost:5173

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="AgriTrade Hub AI" <your_email@gmail.com>
ADMIN_EMAIL=your_email@gmail.com

SIMULATE_EMAIL=false

# Google Sheets & Partner Data Sharing Configuration
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_SHARING_ENABLED=false
GOOGLE_SHEETS_AUTO_SYNC_ENABLED=false
